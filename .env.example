# Public application URL used for auth callbacks, invitation links, and redirects.
NEXT_PUBLIC_APP_URL=

# Public Supabase values. The publishable key is safe for browser use when RLS is enforced.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret. Never prefix with NEXT_PUBLIC or import into client code.
SUPABASE_SECRET_KEY=

# Server-only transactional email configuration.
RESEND_API_KEY=
EMAIL_FROM=

# Optional error monitoring. A browser DSN is intentionally public; auth tokens are not listed here.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
